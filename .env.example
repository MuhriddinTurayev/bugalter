APP_NAME=Bugalter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent

# Single company dev mode: one company in the default database, served on the root host.
# Leave false: companies live on <slug>.PLATFORM_DOMAIN and the root host has no login.
SINGLE_COMPANY=false

# Platform: root host, admin panel on admin.<domain>, one company per <slug>.<domain>.
PLATFORM_DOMAIN=bugalter
# Also serve the admin panel at <root host>/platform (APP_ENV=local only), for machines where admin.<domain> does not resolve.
PLATFORM_PATH_FALLBACK=false
# Local only: extra base domains for company hosts (demo1.localhost works in browsers without a hosts file).
PLATFORM_LOCAL_DOMAINS=
# Local only: lets 2FA enrolment be skipped (ignored in any other environment).
PLATFORM_ADMIN_2FA_OPTIONAL=false
PLATFORM_SESSION_COOKIE=bugalter_platform_session
PLATFORM_SUPPORT_ACCESS_MINUTES=30

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8. docker compose creates this database and user on first start.
# DB_USERNAME must not be "root" when using docker compose.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bugalter
DB_USERNAME=bugalter
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker compose). Web UI: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bugalter.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Signing vault master key: envelope encryption of ERI/E-imzo keys (PLAN section 9). Required outside local.
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"  Keep it out of the database and git.
SIGNING_MASTER_KEY=

# AI providers. Normally entered in the platform panel (Integrations) and stored encrypted; locally,
# `php artisan db:seed` copies these into the panel settings. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Host ports published by docker compose
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
